{
  "name": "redmine-ravnus-theme",
  "version": "0.1.0",
  "private": true,
  "description": "RAVNUS — a Redmine 6.x / 7.x theme with first-class CJK typography",
  "license": "MIT",
  "author": "RAVNUS Inc.",
  "homepage": "https://github.com/RAVNUS-INC/Redmine-RAVNUS-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RAVNUS-INC/Redmine-RAVNUS-theme.git"
  },
  "bugs": {
    "url": "https://github.com/RAVNUS-INC/Redmine-RAVNUS-theme/issues"
  },
  "scripts": {
    "build": "sass --no-source-map --no-charset --style=expanded --fatal-deprecation=import src/application.scss stylesheets/application.css",
    "watch": "npm run build -- --watch"
  },
  "devDependencies": {
    "sass": "1.105.0"
  }
}
